{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"study-journal",
  "main":"src/worker.js",
  "compatibility_date":"2025-01-01",
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application"},
  "d1_databases":[{"binding":"DB","database_name":"study-journal-db","database_id":"REPLACE_WITH_D1_DATABASE_ID"}],
  "r2_buckets":[{"binding":"FILES","bucket_name":"study-journal-files"}]
}